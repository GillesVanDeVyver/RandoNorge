# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# This project uses pnpm only. Never commit an npm/yarn lockfile —
# mixing package managers causes lockfile drift and phantom-dependency build failures.
package-lock.json
yarn.lock

# Wrangler local state (the config itself, wrangler.jsonc, IS committed)
.wrangler

# Timestamped config backups left by scripts/migrate-d1-to-eu.sh step 7, so the
# rollback copy stays local instead of being committed next to the real config —
# two files claiming to be the D1 binding is what stopped that step on 2026-07-29.
wrangler.jsonc.bak-*

# Local secrets for `wrangler dev` (e.g. GOOGLE_CLIENT_SECRET) — never commit
.dev.vars

# Python bytecode. scripts/lib/ is imported by the SQL test harnesses and the
# migration helpers, so running them drops a __pycache__ next to the sources;
# one .pyc was committed by accident in 98ac10c. A .pyc is a build artefact of a
# file already in the repo, it goes stale silently, and a committed one can
# shadow an edited .py on a machine with a matching interpreter version.
__pycache__/
*.py[cod]

# pnpm's content-addressable store, if it is ever pointed inside the tree.
.pnpm-store/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Saved third-party DPA web pages (authenticated captures; keep local, not in VCS)
docs/dpa/

# D1 exports. A dump holds every account, e-mail address and recorded GPS track
# in the service, so one must never reach the repository — and .sql is
# otherwise a committed file type here (migrations/, scripts/), so a plain
# `git add -A` would take it. See docs/D1-EU-JURISDICTION-MIGRATION.md.
*-dump.sql
*.d1-export.sql
