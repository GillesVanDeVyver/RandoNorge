// Cloudflare Workers configuration. The Worker (worker/index.js) proxies
// the three public APIs the app depends on (stamping MET's required
// User-Agent and edge-caching responses) and serves the Vite build in
// dist/ for every other request. Committed so CI deploys (`npx wrangler
// deploy`) use this instead of auto-generating an assets-only config that
// would skip the proxies.
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "fjellrute",
	// The Cloudflare account that owns the zone, this Worker, the R2 bucket
	// and the D1 database. Pinned on 2026-08-08 rather than left to wrangler
	// to infer, because inferring it cost an afternoon: wrangler derives the
	// account from whichever OAuth login is active, caches that choice per
	// checkout in node_modules/.cache/wrangler/wrangler-account.json, and the
	// cache survives `wrangler logout`. The result was `d1 migrations apply`
	// failing with 7403 and then 7404 against two accounts that simply have
	// no databases in them — which reads exactly like a deleted database.
	// With this line a wrong login fails immediately and says which account
	// it wanted. deploy_instructions.md → "Which Cloudflare account" has the
	// full story and the meaning of each error code.
	"account_id": "1558c6da960183cc75e12fbd7a9df3ce",
	"main": "worker/index.js",
	"compatibility_date": "2026-07-12",
	// Better Auth touches a few node: built-ins; workerd provides them
	// natively with this flag (no bundle size cost).
	"compatibility_flags": [
		"nodejs_compat"
	],
	// D1 (SQLite at the edge) stores user accounts, sessions, email
	// verification tokens and — next step — saved routes. Schema changes
	// live in migrations/ and are applied with
	// `npx wrangler d1 migrations apply fjellrute-db-eu --remote`.
	// See docs/AUTH_SETUP.md for the full checklist (incl. secrets).
	//
	// `wrangler dev` now develops against an isolated LOCAL copy of the
	// database. Apply migrations to it with:
	//   npx wrangler d1 migrations apply fjellrute-db-eu --local
	// Add `"remote": true` back to this binding only if you deliberately
	// want dev to read/write the real production database — note that then
	// every D1 query is a network round-trip through wrangler's remote-dev
	// proxy, which can stall and hang the request (that proxy fronts D1 with
	// a single serializing object, so one stalled query wedges every later
	// request until you restart the dev server).
	//
	// 2026-07-29: moved into Cloudflare's EU jurisdiction. A jurisdiction can
	// only be set when a database is created, so this is a new database with a
	// verified copy of the old one — see docs/D1-EU-JURISDICTION-MIGRATION.md.
	// HISTORICAL, NOT A ROLLBACK. The database these two values name was deleted
	// on 2026-07-29, the same evening as the cutover, along with the export taken
	// from it. Putting them back would bind the Worker to a database that no
	// longer exists. They are kept only so the id in the migration document can
	// be matched to something, and so `git log` is not the only record:
	//   "database_name": "fjellrute-db",
	//   "database_id": "fc24cf1f-35c7-4c9d-8a5a-4de38a3865fb"
	// Recovery for this database is D1 Time Travel, which restores a live
	// database to an earlier minute — it cannot recover a dropped one. Do not
	// answer that by keeping a SQL export around: a plaintext copy of every
	// account and GPS track sitting in a working directory is the exact
	// storage-limitation problem the move was made to fix.
	// The binding stays DB: worker/ reaches the database through env.DB
	// throughout, so renaming it here would mean renaming it everywhere.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "fjellrute-db-eu",
			"database_id": "1d6f92bf-83c8-4dce-80f6-d20b4a09674b",
			"migrations_dir": "migrations"
		}
	],
	// R2 bucket with self-generated Terrarium terrain tiles (Kartverket NDH
	// DTM, CC BY 4.0) served by worker/terrain.js at /terrain-dem/* with
	// AWS Open Data fallback for uncovered areas. Create the bucket once:
	//   npx wrangler r2 bucket create fjellrute-terrain
	// Generate + upload tiles: scripts/terrain/make_terrarium_tiles.py.
	//
	// ONE binding for this bucket, and it is TERRAIN: worker/terrain.js reads
	// env.TERRAIN and nothing else. Removed 2026-07-29: a second entry
	// (binding "fjellrute_terrain", "remote": true, same bucket) had been added
	// by wrangler's "Would you like Wrangler to add it on your behalf?" prompt,
	// which names the binding after the resource and opts it into the remote
	// resource. Nothing read it, but `wrangler dev` reached the real production
	// bucket through it. Answer NO to that prompt — the same prompt appended a
	// duplicate d1_databases entry and stopped step 7 of
	// docs/D1-EU-JURISDICTION-MIGRATION.md. Unlike D1, nothing validates that
	// R2 has exactly one binding per bucket, so a duplicate here deploys in
	// silence; the only sign is two rows for one bucket in the bindings table
	// that `wrangler deploy` prints.
	"r2_buckets": [
		{
			"binding": "TERRAIN",
			"bucket_name": "fjellrute-terrain"
		}
	],
	// Sender for auth emails (worker/email.js). Resend only sends from
	// domains verified in its dashboard. fjellrute.no must show "Verified"
	// in Resend (SPF/DKIM/return-path DNS added to the Cloudflare .no zone)
	// before this address can deliver — complete that before deploying.
	"vars": {
		"EMAIL_FROM": "Fjellrute <no-reply@fjellrute.no>",
		// Inbox for in-app feedback (worker/feedback.js). The same address the
		// privacy policy publishes for GDPR requests, so a reply arrives from
		// somewhere the user has already been told about. Unlike EMAIL_FROM this
		// is a recipient, not a sender, so it needs no verification in Resend —
		// any mailbox works. Feedback still *leaves* as EMAIL_FROM, with the
		// sender's address in Reply-To.
		"FEEDBACK_TO": "contact@fjellrute.no",
		// Google OAuth client (project "fjellrute" in Google Cloud console).
		// The matching GOOGLE_CLIENT_SECRET is a Worker secret; the provider
		// stays disabled in worker/auth.js until both are present.
		"GOOGLE_CLIENT_ID": "14850983815-qtutomkpjvf92rribcm9d7e9rv0foflt.apps.googleusercontent.com"
	},
	"observability": {
		"enabled": true
	},
	"assets": {
		"directory": "dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		// WHICH REQUESTS REACH THE WORKER. A path that is not matched here is
		// answered by the assets binding alone: the file if one exists, and
		// otherwise the SPA fallback configured above — dist/index.html with
		// HTTP 200. The Worker script never runs for it. Four things depend on
		// the Worker running, and each of them was lost, at some point, by a
		// path not being listed:
		//
		//   1. The APIs. /api/... and the three upstream proxies must be the
		//      Worker's, or the frontend is handed index.html where it asked for
		//      JSON (empty snow data, "weather unavailable").
		//   2. The site root. worker/index.js answers "/" with the closed-alpha
		//      "Kommer snart" page (public/coming-soon.html); the assets
		//      fallback would answer it with the app. The app itself lives under
		//      /alpha/ — see src/appBase.ts.
		//   3. Security headers. worker/securityHeaders.js wraps every response
		//      the Worker returns (CSP, HSTS, X-Frame-Options, …). Verified
		//      against production on 2026-07-31, when only a named allowlist was
		//      here: "/" had the full CSP + HSTS, while /alpha/, /privacy and
		//      /about had none of the three. The app was the least protected
		//      page on the site.
		//   4. Cache behaviour on HTML. The Worker sets "Cache-Control:
		//      no-cache" on the HTML shell (end of worker/index.js); ASSETS
		//      sends "max-age=0, must-revalidate". A cached shell is a stale
		//      index.html asking for bundles that a later deploy has removed —
		//      which is also what the /assets/ branch in worker/index.js guards,
		//      by turning a missing hashed bundle into a real 404 rather than
		//      letting the SPA fallback hand the browser index.html to execute
		//      as JavaScript, blanking the page.
		//
		// WHY "/*" AND NOT A LIST. This was a list — "/", "/assets/*", "/api/*",
		// "/alpha", "/alpha/*", "/about", "/privacy", "/u/*" and the proxies —
		// which is to say a list of the paths someone had thought of, and
		// therefore not of the ones nobody had. Every path outside it got the
		// SPA fallback, and src/Root.tsx's pathToNav() ends in a default view,
		// so https://fjellrute.no/xx served the closed alpha's login screen to
		// anyone who mistyped the domain, as did every scanner probing for
		// /wp-admin. The allowlist of URLs this site actually has now lives in
		// worker/knownPaths.js, where a miss can be redirected instead of
		// silently rendered; this array's only job is to get the Worker in front
		// of anything that might be a document request.
		//
		// WHAT THE EXCLUSIONS ARE FOR. "/*" on its own would bill every photo
		// and weather icon as a Worker request — the reason
		// `"run_worker_first": true` was rejected and must stay rejected
		// (docs/cost-and-limits.md, 100k requests/day). So the static media that
		// makes up the bulk of a page load goes straight from assets, exactly as
		// before: the 83 MET weather icons and the eight login/overview
		// photographs. What is left is HTML documents — a handful per visit —
		// plus the hashed bundles under /assets/, which were Worker-first
		// already. No meaningful change against the budget.
		//
		// The few remaining root files (favicon, app icons) do go through the
		// Worker. Three cached requests per visitor is not worth another glob,
		// because:
		//
		// EVERY EXCLUSION IS ANCHORED TO A LITERAL PREFIX, AND MUST STAY THAT
		// WAY. "*" in these globs matches across "/" too, so the obvious
		// spelling of "static images" — "!/*.png" — also matches
		// /terrain-dem/12/2145/1088.png, and took the 3D view's heightmap tiles
		// away from worker/terrain.js: assets answered them with index.html,
		// HTTP 200, and MapLibre got HTML where it wanted terrain. Caught by
		// curl against `wrangler dev` before it shipped, by nothing that reads
		// this file. Name the directory or the filename prefix, never the
		// extension alone.
		//
		// The trade for an excluded pattern is that a *missing* file of that
		// kind gets the SPA fallback instead of a 404, since the Worker never
		// sees it. That is the pre-existing behaviour for images and it breaks
		// nothing — a broken <img> is a broken <img> either way. Do not extend
		// the exclusions to extensionless paths: those are the ones a person can
		// type, and they are the whole reason this array changed.
		//
		// WHEN THE ALPHA OPENS: APP_BASE becomes '' in src/appBase.ts and
		// worker/knownPaths.js together, and "/" stops serving the holding page
		// (drop that block from worker/index.js). Nothing in this array needs to
		// change — it names no routes, which is the point of it.
		"run_worker_first": [
			"/*",
			"!/weather-icons/*",
			"!/login-*.jpg",
			"!/overview-*.jpg"
		]
	},
	// Daily GDPR retention cleanup (worker/index.js scheduled handler):
	// purges expired session rows (they contain IP address + user agent)
	// and expired email-verification tokens. 03:47 UTC — low-traffic and
	// off the full hour, as Cloudflare recommends for cron triggers.
	"triggers": {
		"crons": [
			"47 3 * * *"
		]
	}
}